{
  "extends": [
    "airbnb-base",
    "plugin:sonarjs/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "jest",
    "@typescript-eslint",
    "sonarjs",
    "eslint-comments"
  ],
  "env": {
    "node": true,
    "jest/globals": true
  },
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [
          ".js",
          ".jsx",
          ".ts",
          ".tsx"
        ]
      }
    },
    "import/core-modules": [
      "aws-sdk",
      "aws-lambda",
      "@aws-sdk/client-lambda",
      "aws-sdk/clients/dynamodb",
      "@eMarketeerSE/dev-commons",
      "@aws-sdk/client-dynamodb",
      "@aws-sdk/client-sqs",
      "@aws-sdk/client-sns",
      "@aws-sdk/client-ses",
      "@aws-sdk/client-sts",
      "@aws-sdk/client-kinesis",
      "@aws-sdk/client-cloudwatch",
      "aws-sdk/clients/lambda",
      "@aws-sdk/client-s3",
      "aws-sdk/clients/ses",
      "@aws-sdk/client-api-gateway",
      "@aws-sdk/client-cloudfront",
      "@aws-sdk/lib-dynamodb",
      "@aws-sdk/credential-providers"
    ]
  },
  "rules": {
    "curly": ["error", "all"],
    "no-unreachable-loop": ["error", { "ignore": ["ForOfStatement"] }],
    "@typescript-eslint/semi": [
      "error",
      "never"
    ],
    "@typescript-eslint/member-delimiter-style": [
      "error",
      {
        "multiline": {
          "delimiter": "none",
          "requireLast": false
        },
        "singleline": {
          "delimiter": "semi",
          "requireLast": false
        }
      }
    ],
    "semi": "off",
    "prefer-template": "off",
    "max-len": [
      "error",
      {
        "code": 120
      }
    ],
    "no-console": "off",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "PropertyDefinition[computed=false]:has(Decorator > CallExpression[callee.name=/^(Property|Enum|Embedded|Formula|Column|PrimaryColumn)$/] > ObjectExpression > Property[key.name=\"nullable\"][value.value=true]):not(:has(PropertyDefinition > TSTypeAnnotation > TSUnionType > TSNullKeyword)):not(:has(PropertyDefinition > TSTypeAnnotation > TSNullKeyword))",
        "message": "This column is nullable, so the property type has to include null. Write `T | null`, not `?: T` and not plain `T` (DV-4523)."
      },
      {
        "selector": ":matches(CallExpression[callee.property.name=\"each\"], TaggedTemplateExpression[tag.property.name=\"each\"]):matches([callee.object.name=/^(it|test|describe)$/], [callee.object.object.name=/^(it|test|describe)$/], [callee.object.object.object.name=/^(it|test|describe)$/], [tag.object.name=/^(it|test|describe)$/], [tag.object.object.name=/^(it|test|describe)$/], [tag.object.object.object.name=/^(it|test|describe)$/])",
        "message": "Parametrized tests are not allowed. Write a separate it() block per case with inline assertions."
      },
      {
        "selector": ":matches(ClassDeclaration, ClassExpression):matches([superClass.name=/Error$/], [superClass.property.name=/Error$/])",
        "message": "Do not subclass Error. Throw a plain Error and put any distinguishing data in a property on it."
      }
    ],
    "import/prefer-default-export": "off",
    "object-curly-newline": [
      "error",
      {
        "consistent": true
      }
    ],
    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": [
          "**/*.test.ts",
          "**/*.spec.ts"
        ]
      }
    ],
    "no-undef": "off",
    "no-shadow": "off",
    "@typescript-eslint/no-shadow": ["error"],
    "no-await-in-loop": "off",
    "prefer-destructuring": "off",
    "sonarjs/no-duplicate-string": "off",
    "arrow-body-style": "warn",
    "no-useless-constructor": "off",
    "@typescript-eslint/no-useless-constructor": ["error"],
    "no-empty-function": "off",
    "@typescript-eslint/no-empty-function": ["error"],
    "default-param-last": "off",
    "no-plusplus": "off",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ],
    "class-methods-use-this": "off",
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "never",
        "jsx": "never",
        "ts": "never",
        "tsx": "never"
      }
    ],
    "eslint-comments/require-description": [
      "error",
      { "ignore": ["eslint-enable", "eslint-env", "exported", "global", "globals"] }
    ],
    "@typescript-eslint/consistent-type-definitions": ["error", "interface"],
    "import/no-default-export": "error"
  },
  "overrides": [
    {
      "files": [
        "src/db/migrations/**",
        "src/migrations/**",
        "src/utils/func-test-setup.ts",
        "src/utils/func-test-teardown.ts",
        "**/*.d.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts"],
      "excludedFiles": [
        "**/*[.-]unit.test.ts",
        "**/*[.-]func.test.ts",
        "**/*[.-]full-cycle.test.ts",
        "**/*.so.test.ts",
        "**/*.dynamics-e2e.test.ts",
        "**/*.sweep.test.ts"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "PropertyDefinition[computed=false]:has(Decorator > CallExpression[callee.name=/^(Property|Enum|Embedded|Formula|Column|PrimaryColumn)$/] > ObjectExpression > Property[key.name=\"nullable\"][value.value=true]):not(:has(PropertyDefinition > TSTypeAnnotation > TSUnionType > TSNullKeyword)):not(:has(PropertyDefinition > TSTypeAnnotation > TSNullKeyword))",
            "message": "This column is nullable, so the property type has to include null. Write `T | null`, not `?: T` and not plain `T` (DV-4523)."
          },
          {
            "selector": ":matches(CallExpression[callee.property.name=\"each\"], TaggedTemplateExpression[tag.property.name=\"each\"]):matches([callee.object.name=/^(it|test|describe)$/], [callee.object.object.name=/^(it|test|describe)$/], [callee.object.object.object.name=/^(it|test|describe)$/], [tag.object.name=/^(it|test|describe)$/], [tag.object.object.name=/^(it|test|describe)$/], [tag.object.object.object.name=/^(it|test|describe)$/])",
            "message": "Parametrized tests are not allowed. Write a separate it() block per case with inline assertions."
          },
          {
            "selector": ":matches(ClassDeclaration, ClassExpression):matches([superClass.name=/Error$/], [superClass.property.name=/Error$/])",
            "message": "Do not subclass Error. Throw a plain Error and put any distinguishing data in a property on it."
          },
          {
            "selector": "Program",
            "message": "Test files are named *.unit.test.ts, *.func.test.ts or *.full-cycle.test.ts, so em-commons jest runs them in the right tier."
          }
        ]
      }
    }
  ]
}
